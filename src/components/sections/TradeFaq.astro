---
import Container from "@/components/layout/Container.astro";
import SectionLabel from "@/components/shared/SectionLabel.astro";
import ScrollReveal from "@/components/shared/ScrollReveal.astro";
import type { TradeFaq } from "@/lib/trades";

interface Props {
  heading: string;
  faqs: TradeFaq[];
}

const { heading, faqs } = Astro.props;

// Visible content and structured data are generated from the same source,
// so the FAQPage markup always matches what the user actually sees.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};
---
<section id="faq" class="bg-surface-muted py-[clamp(80px,10vw,160px)]">
  <Container>
    <div class="grid gap-12 md:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <ScrollReveal>
        <div class="md:sticky md:top-32">
          <SectionLabel text="Fragen & Antworten" />
          <h2 class="mb-4 font-heading text-3xl text-text sm:text-4xl">{heading}</h2>
          <p class="mb-6 leading-relaxed text-text-secondary">
            Offene Fragen? Schreiben Sie mir – ich melde mich innerhalb von 24 Stunden.
          </p>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 text-sm font-medium text-accent transition-colors hover:text-accent-hover"
          >
            Schreiben Sie mir direkt
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </ScrollReveal>

      <ScrollReveal delay={100}>
        <div class="divide-y divide-border rounded-2xl border border-border bg-surface px-2 md:px-4">
          {faqs.map((faq) => (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-5 font-medium text-text [&::-webkit-details-marker]:hidden">
                {faq.question}
                <svg
                  class="h-5 w-5 shrink-0 text-accent transition-transform duration-200 group-open:rotate-45"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
              </summary>
              <div class="px-4 pb-5 leading-relaxed text-text-secondary">{faq.answer}</div>
            </details>
          ))}
        </div>
      </ScrollReveal>
    </div>
  </Container>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
